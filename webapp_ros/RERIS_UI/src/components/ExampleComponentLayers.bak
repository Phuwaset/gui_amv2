<template class="main-container">
  <div class="map-container">
    <div class="status" :class="{ connected: isConnected, disconnected: !isConnected }">
      {{ isConnected ? 'Connected' : 'Disconnected' }}
    </div>
    <div class="canvas-container" 
         @wheel="handleWheel" 
         @touchstart="handleTouchStart" 
         @touchmove="handleTouchMove"
         @touchend="handleTouchEnd" 
         @mousedown="handleMouseDown" 
         @mousemove="handleMouseMove" 
         @mouseup="handleMouseUp"
         @mouseleave="handleMouseUp">
      
      <!-- Main composite canvas -->
      <canvas ref="canvas" 
              :width="canvasWidth" 
              :height="canvasHeight" 
              @click="handleGoalClick"
              class="main-canvas">
      </canvas>
      
      <!-- Debug layer visibility controls (optional) -->
      <div class="layer-controls" v-if="showDebugControls">
        <label>
          <input type="checkbox" v-model="layerVisibility.map" @change="drawCompositeMap(true)"> Map
        </label>
        <label>
          <input type="checkbox" v-model="layerVisibility.robot" @change="drawCompositeMap(true)"> Robot
        </label>
        <label>
          <input type="checkbox" v-model="layerVisibility.target" @change="drawCompositeMap(true)"> Target
        </label>
      </div>
    </div>
  </div>
  
  <!-- Joystick Container -->
  <div class="joystick-container" :style="{ bottom: joystickBottomPosition + 'px' }">
    <JoystickComponent @updateVelocity="handleVelocity" />
    <p>Velocity X: {{ Vx.toFixed(2) }}</p>
    <p>Velocity Y: {{ Vy.toFixed(2) }}</p>
  </div>
  
  <div class="zoom-container">
    <div class="zoom-controls">
      <button @click="zoomIn">+</button>
      <button @click="zoomOut">-</button>
    </div>
    <div class="zoom-size">
      Size: {{ zoomLevel.toFixed(1) }}
    </div>
    <div class="performance-info" v-if="showPerformanceInfo">
      <div>FPS: {{ currentFPS }}</div>
      <div>Layers Dirty: {{ dirtyLayersCount }}</div>
    </div>
  </div>
</template>

<script setup lang="ts">
import JoystickComponent from 'components/JoystickComponent.vue';
import { ref, onMounted, onBeforeUnmount, computed } from 'vue';

interface OccupancyGrid {
  width: number;
  height: number;
  resolution: number;
  origin_x: number;
  origin_y: number;
  data: number[];
  downsampled: boolean;
  originalDimensions: { width: number; height: number };
}

// Existing reactive variables
const canvas = ref<HTMLCanvasElement | null>(null);
const mapData = ref<OccupancyGrid | null>(null);
const robotPosition = ref<{ x: number; y: number, yaw: number }>({ x: 0, y: 0, yaw: 0 });
const isConnected = ref(false);
const zoomLevel = ref(1.0);
const canvasWidth = ref(1080);
const canvasHeight = ref(1080);
const offsetX = ref(0);
const offsetY = ref(0);
const isDragging = ref(false);
const startDrag = ref({ x: 0, y: 0 });
const singleGoal = ref<{ x: number; y: number, yaw: number }>({ x: 0, y: 0, yaw: 0 });
const touchStart = ref<{ x: number; y: number }>({ x: 0, y: 0 });
const Vx = ref(0);
const Vy = ref(0);

// New layered rendering variables
const layerVisibility = ref({
  map: true,
  robot: true,
  target: true
});

const showDebugControls = ref(false); // Set to true for debugging
const showPerformanceInfo = ref(true);
const currentFPS = ref(0);

// Layer management state
const layerCache = {
  map: null as HTMLCanvasElement | null,
  robot: null as HTMLCanvasElement | null,
  target: null as HTMLCanvasElement | null
};

const layerDirty = {
  map: true,
  robot: true,
  target: true
};

const dirtyLayersCount = computed(() => {
  return Object.values(layerDirty).filter(Boolean).length;
});

// Performance tracking
let lastRobotPosition = { x: 0, y: 0, yaw: 0 };
let lastTargetPosition = { x: 0, y: 0, yaw: 0 };
let lastMapData: OccupancyGrid | null = null;
let frameCount = 0;
let lastFPSTime = performance.now();
let lastDrawTime = 0;
const DRAW_INTERVAL = 1000 / 60; // 60 FPS limit

// WebSocket and touch handling
let ws: WebSocket | null = null;
let reconnectTimeout: number | null = null;
let touchStartDist = 0;
let touchStartZoom = 1.0;
let resizeTimeout: number | null = null;

// Reference to the menu bar
const menuBar = ref<HTMLElement | null>(null);

// The dynamic bottom position of the joystick based on menu height
const joystickBottomPosition = computed(() => {
  if (menuBar.value) {
    const menuBarHeight = menuBar.value.offsetHeight;
    return Math.max(10, 10 + menuBarHeight);
  }
  return 10;
});

// Performance monitoring
const updateFPS = () => {
  frameCount++;
  const currentTime = performance.now();
  if (currentTime - lastFPSTime >= 1000) {
    currentFPS.value = Math.round((frameCount * 1000) / (currentTime - lastFPSTime));
    frameCount = 0;
    lastFPSTime = currentTime;
  }
};

// Map Layer - Only redraws when map data changes
const drawMapLayer = () => {
  if (!mapData.value || !layerDirty.map || !layerVisibility.value.map) return;
  
  const { width, height, data } = mapData.value;
  
  // Create or reuse map canvas
  if (!layerCache.map) {
    layerCache.map = document.createElement('canvas');
  }
  
  layerCache.map.width = width;
  layerCache.map.height = height;
  const ctx = layerCache.map.getContext('2d');
  if (!ctx) return;
  
  ctx.imageSmoothingEnabled = false;
  
  // Generate map image data
  const imgData = ctx.createImageData(width, height);
  const imgArray = imgData.data;
  
  for (let i = 0; i < data.length; i++) {
    const val = data[i];
    const x = i % width;
    const y = Math.floor(i / width);
    const flippedY = height - 1 - y;
    
    const color = val === -1 ? 127 : val === 0 ? 240 : val === 100 ? 0 : 255 - val * 2.55;
    const index = (flippedY * width + x) * 4;
    
    imgArray[index] = imgArray[index + 1] = imgArray[index + 2] = color;
    imgArray[index + 3] = 255;
  }
  
  ctx.putImageData(imgData, 0, 0);
  layerDirty.map = false;
  lastMapData = { ...mapData.value };
};

// Robot Layer - Only redraws when robot position/orientation changes
const drawRobotLayer = () => {
  if (!robotPosition.value || !mapData.value || !layerDirty.robot || !layerVisibility.value.robot) return;
  
  const { x, y, yaw } = robotPosition.value;
  const { width, height, resolution, origin_x, origin_y } = mapData.value;
  
  // Create or reuse robot canvas
  if (!layerCache.robot) {
    layerCache.robot = document.createElement('canvas');
  }
  
  layerCache.robot.width = canvasWidth.value;
  layerCache.robot.height = canvasHeight.value;
  const ctx = layerCache.robot.getContext('2d');
  if (!ctx) return;
  
  // Clear the canvas
  ctx.clearRect(0, 0, canvasWidth.value, canvasHeight.value);
  
  // Calculate robot position on canvas
  const robotX = ((x - origin_x) / resolution) * (canvasWidth.value / width) + offsetX.value;
  const robotY = ((origin_y + height * resolution - y) / resolution) * (canvasHeight.value / height) + offsetY.value;
  
  // Draw robot triangle
  const triangleSize = 10 * zoomLevel.value;
  const halfSize = triangleSize / 2;
  const cosA = Math.cos(yaw);
  const sinA = Math.sin(yaw);
  
  const points = [
    { x: 0, y: -triangleSize },
    { x: -halfSize, y: halfSize },
    { x: halfSize, y: halfSize }
  ].map(({ x: px, y: py }) => ({
    x: px * cosA - py * sinA + robotX,
    y: px * sinA + py * cosA + robotY
  }));
  
  ctx.fillStyle = "green";
  ctx.beginPath();
  ctx.moveTo(points[0].x, points[0].y);
  ctx.lineTo(points[1].x, points[1].y);
  ctx.lineTo(points[2].x, points[2].y);
  ctx.closePath();
  ctx.fill();
  
  // Draw robot detection circle
  const circleRadius = Math.min(triangleSize * 2, Math.min(canvasWidth.value, canvasHeight.value) * 0.085);
  ctx.fillStyle = "rgba(0, 255, 0, 0.3)";
  ctx.beginPath();
  ctx.arc(robotX, robotY, circleRadius, 0, 2 * Math.PI);
  ctx.fill();
  
  layerDirty.robot = false;
  lastRobotPosition = { x, y, yaw };
};

// Target Layer - Only redraws when target changes
const drawTargetLayer = () => {
  if (!singleGoal.value || !mapData.value || !layerDirty.target || !layerVisibility.value.target) return;
  
  const { width, height, resolution, origin_x, origin_y } = mapData.value;
  
  // Create or reuse target canvas
  if (!layerCache.target) {
    layerCache.target = document.createElement('canvas');
  }
  
  layerCache.target.width = canvasWidth.value;
  layerCache.target.height = canvasHeight.value;
  const ctx = layerCache.target.getContext('2d');
  if (!ctx) return;
  
  // Clear the canvas
  ctx.clearRect(0, 0, canvasWidth.value, canvasHeight.value);
  
  // Check if target should be visible (distance check)
  if (robotPosition.value) {
    const { x: robotX, y: robotY } = robotPosition.value;
    const currentDist = Math.sqrt((robotX * robotX) + (robotY * robotY));
    const markerDistError = Math.sqrt((singleGoal.value.x * singleGoal.value.x) + (singleGoal.value.y * singleGoal.value.y)) - currentDist;
    
    if (Math.abs(markerDistError) >= 0.20) {
      drawMarker(ctx, singleGoal.value.x, singleGoal.value.y, width, height, resolution, origin_x, origin_y);
    }
  }
  
  layerDirty.target = false;
  lastTargetPosition = { ...singleGoal.value };
};

// Helper function for drawing markers
const drawMarker = (ctx: CanvasRenderingContext2D, x: number, y: number, mapWidth: number, mapHeight: number, resolution: number, origin_x: number, origin_y: number, color = "#d00") => {
  const markerX = ((x - origin_x) / resolution) * (canvasWidth.value / mapWidth) + offsetX.value;
  const markerY = ((origin_y + mapHeight * resolution - y) / resolution) * (canvasHeight.value / mapHeight) + offsetY.value;
  
  ctx.save();
  
  // Marker base (pin head)
  ctx.beginPath();
  ctx.arc(markerX, markerY - 10, 10, 0, Math.PI * 2, true);
  ctx.fillStyle = color;
  ctx.fill();
  ctx.closePath();
  
  // Marker tip (triangle tail)
  ctx.beginPath();
  ctx.moveTo(markerX, markerY);
  ctx.lineTo(markerX - 7, markerY - 10);
  ctx.lineTo(markerX + 7, markerY - 10);
  ctx.closePath();
  ctx.fillStyle = color;
  ctx.fill();
  
  // White circle center
  ctx.beginPath();
  ctx.arc(markerX, markerY - 10, 4, 0, Math.PI * 2, true);
  ctx.fillStyle = "#fff";
  ctx.fill();
  ctx.closePath();
  
  ctx.restore();
};

// Check what needs to be redrawn
const checkLayerUpdates = () => {
  // Check if map data changed
  if (mapData.value && (!lastMapData || 
      mapData.value.width !== lastMapData.width ||
      mapData.value.height !== lastMapData.height ||
      JSON.stringify(mapData.value.data) !== JSON.stringify(lastMapData.data))) {
    layerDirty.map = true;
    layerDirty.robot = true; // Robot position on canvas changes with map
    layerDirty.target = true; // Target position on canvas changes with map
  }
  
  // layerDirty.map = true;
  // layerDirty.robot = true; // Robot position on canvas changes with map
  // layerDirty.target = true; // Target position on canvas changes with map
  
  
  // Check if robot position changed (with threshold for noise)
  const positionThreshold = 0.01; // 1cm threshold
  const angleThreshold = 0.01; // ~0.6 degree threshold
  
  if (robotPosition.value && 
      (Math.abs(robotPosition.value.x - lastRobotPosition.x) > positionThreshold || 
       Math.abs(robotPosition.value.y - lastRobotPosition.y) > positionThreshold || 
       Math.abs(robotPosition.value.yaw - lastRobotPosition.yaw) > angleThreshold)) {
    layerDirty.robot = true;
    layerDirty.target = true; // Target visibility depends on robot position
  }
  
  // Check if target changed
  if (singleGoal.value && 
      (singleGoal.value.x !== lastTargetPosition.x || 
       singleGoal.value.y !== lastTargetPosition.y)) {
    layerDirty.target = true;
  }
};

// Main composite drawing function
const drawCompositeMap = (force: boolean = false) => {
  if (!canvas.value || !mapData.value) return;
  
  const currentTime = performance.now();
  if (currentTime - lastDrawTime < DRAW_INTERVAL && !force) return;
  lastDrawTime = currentTime;
  
  // Force redraw all layers if requested
  if (force) {
    layerDirty.map = true;
    layerDirty.robot = true;
    layerDirty.target = true;
  }
  
  checkLayerUpdates();
  
  // Only redraw dirty layers
  if (layerDirty.map) drawMapLayer();
  if (layerDirty.robot) drawRobotLayer();
  if (layerDirty.target) drawTargetLayer();
  
  // Composite all layers onto main canvas
  const ctx = canvas.value.getContext('2d');
  if (!ctx) return;
  
  ctx.clearRect(0, 0, canvasWidth.value, canvasHeight.value);
  
  // Draw map layer (scaled and positioned)
  if (layerCache.map && layerVisibility.value.map) {
    const { width, height } = mapData.value;
    ctx.drawImage(
      layerCache.map, 
      0, 0, width, height,
      offsetX.value, offsetY.value, canvasWidth.value, canvasHeight.value
    );
  }
  
  // Draw robot layer
  if (layerCache.robot && layerVisibility.value.robot) {
    ctx.drawImage(layerCache.robot, 0, 0);
  }
  
  // Draw target layer
  if (layerCache.target && layerVisibility.value.target) {
    ctx.drawImage(layerCache.target, 0, 0);
  }
  
  updateFPS();
};

// Invalidate all layers
const invalidateAllLayers = () => {
 layerDirty.map = true;
 layerDirty.robot = true;
 layerDirty.target = true;
};

// WebSocket connection management
const connectWebSocket = () => {
  if (ws) {
    ws.close();
  }

  ws = new WebSocket('ws://192.168.10.2:7448');

  ws.onopen = () => {
    console.log('WebSocket connection established');
    isConnected.value = true;
    if (reconnectTimeout !== null) {
      clearTimeout(reconnectTimeout);
      reconnectTimeout = null;
    }
  };

  ws.onmessage = (event) => {
    try {
      const { map, odom } = JSON.parse(event.data);
     
      let mapChanged = false;
      let robotChanged = false;
      
      // Handle map data
      if (map.width && map.height && map.data) {
        const newMapData = {
          ...map,
          resolution: map.resolution,
          origin_x: map.origin ? map.origin[0] : 0,
          origin_y: map.origin ? map.origin[1] : 0,
          data: map.compressed ? decompressData(map.data) : map.data,
          // downsampled: map.downsampled,
          originalDimensions: map.original_dimensions
        };
        
        // Check if map actually changed
        if (!mapData.value || 
            mapData.value.width !== newMapData.width ||
            mapData.value.height !== newMapData.height ||
            JSON.stringify(mapData.value.data) !== JSON.stringify(newMapData.data)) {
          mapData.value = newMapData;
          mapChanged = true;
          layerDirty.map = true;
          adjustCanvasSize();
        }
      }
      
      // Handle robot position
      const newRobotPosition = {
        x: odom.position.x,
        y: odom.position.y,
        yaw: -(quaternionToEuler(odom.orientation.x, odom.orientation.y, odom.orientation.z, odom.orientation.w).yaw - 1.5708)
      };
      
      // Check if robot position actually changed (with threshold for noise)
      const positionThreshold = 0.01; // 1cm threshold
      const angleThreshold = 0.01; // ~0.6 degree threshold
      
      if (!robotPosition.value ||
          Math.abs(robotPosition.value.x - newRobotPosition.x) > positionThreshold ||
          Math.abs(robotPosition.value.y - newRobotPosition.y) > positionThreshold ||
          Math.abs(robotPosition.value.yaw - newRobotPosition.yaw) > angleThreshold) {
        robotPosition.value = newRobotPosition;
        robotChanged = true;
        layerDirty.robot = true;
        layerDirty.target = true; // Target visibility depends on robot position
      }
      
      // Only redraw if something actually changed
      if (mapChanged || robotChanged) {
        drawCompositeMap();
      }
      
    } catch (error) {
      console.error('WebSocket error:', error);
    }
  };

  ws.onerror = (error) => {
    console.error('WebSocket error:', error);
    isConnected.value = false;
  };

  ws.onclose = () => {
    console.log('WebSocket connection closed');
    isConnected.value = false;

    reconnectTimeout = window.setTimeout(() => {
      console.log('Attempting to reconnect...');
      connectWebSocket();
    }, 5000);
  };
};

// Utility functions
const decompressData = (compressedData: [number, number][]) => {
  const result: number[] = [];
  for (const [value, count] of compressedData) {
    for (let i = 0; i < count; i++) {
      result.push(value);
    }
  }
  return result;
};

const adjustCanvasSize = () => {
  if (!mapData.value) return;

  const aspectRatio = mapData.value.width / mapData.value.height;
  const viewportWidth = window.innerWidth * 0.99;
  const viewportHeight = window.innerHeight * 0.97;

  if (aspectRatio > 1) {
    canvasWidth.value = Math.min(viewportWidth, mapData.value.width * zoomLevel.value);
    canvasHeight.value = canvasWidth.value / aspectRatio;
  } else {
    canvasHeight.value = Math.min(viewportHeight, mapData.value.height * zoomLevel.value);
    canvasWidth.value = canvasHeight.value * aspectRatio;
  }
};

function quaternionToEuler(x: number, y: number, z: number, w: number) {
  const sinr_cosp = 2 * (w * x + y * z);
  const cosr_cosp = 1 - 2 * (x * x + y * y);
  const roll = Math.atan2(sinr_cosp, cosr_cosp);

  const sinp = 2 * (w * y - z * x);
  const pitch = Math.asin(Math.max(-1, Math.min(1, sinp)));

  const siny_cosp = 2 * (w * z + x * y);
  const cosy_cosp = 1 - 2 * (y * y + z * z);
  const yaw = Math.atan2(siny_cosp, cosy_cosp);

  return { roll, pitch, yaw };
}

// Event handlers
const zoomIn = () => {
  zoomLevel.value += 0.1;
  adjustCanvasSize();
  invalidateAllLayers();
  drawCompositeMap(true);
};

const zoomOut = () => {
  zoomLevel.value -= 0.1;
  zoomLevel.value = Math.max(0.1, zoomLevel.value);
  adjustCanvasSize();
  invalidateAllLayers();
  drawCompositeMap(true);
};

const handleWheel = (event: WheelEvent) => {
  if (event.deltaY < 0) {
    zoomIn();
  } else {
    zoomOut();
  }
  event.preventDefault();
};

const handleGoalClick = (event: MouseEvent) => {
  if (!canvas.value || !mapData.value || !robotPosition.value) {
    console.warn('Cannot handle goal click: missing canvas, map data, or robot position.');
    return;
  }

  const { resolution, origin_x, origin_y, width: mapWidth, height: mapHeight } = mapData.value;
  const { x: robotX_world, y: robotY_world, yaw: robotYaw_world } = robotPosition.value;
  const rect = canvas.value.getBoundingClientRect();

  const clickX_on_canvas = event.clientX - rect.left;
  const clickY_on_canvas = event.clientY - rect.top;

  const mapPixelX = (clickX_on_canvas - offsetX.value) / zoomLevel.value;
  const mapPixelY = (clickY_on_canvas - offsetY.value) / zoomLevel.value;

  if (mapPixelX < 0 || mapPixelX > mapWidth || mapPixelY < 0 || mapPixelY > mapHeight) {
    console.warn('Clicked position is outside the map bounds.');
    return;
  }

  const clickedX_world = origin_x + mapPixelX * resolution;
  const clickedY_world = origin_y + (mapHeight - mapPixelY) * resolution;

  const translatedX = clickedX_world - robotX_world;
  const translatedY = clickedY_world - robotY_world;

  const cosYaw = Math.cos(robotYaw_world);
  const sinYaw = Math.sin(robotYaw_world);
  const goalX_robotFrame = translatedX * cosYaw + translatedY * sinYaw;
  const goalY_robotFrame = -translatedX * sinYaw + translatedY * cosYaw;

  // Update goal and mark target layer as dirty
  singleGoal.value = { x: clickedX_world, y: clickedY_world, yaw: 0 };
  layerDirty.target = true;

  const singleGoalPackage = {
    "action": "goal_cmd",
    x: singleGoal.value.x,
    y: singleGoal.value.y,
    yaw: singleGoal.value.yaw
  };

  if (ws && ws.readyState === WebSocket.OPEN) {
    ws.send(JSON.stringify(singleGoalPackage));
  }

  drawCompositeMap();

  console.log(`Goal marked in world coordinates at: (${clickedX_world.toFixed(2)}, ${clickedY_world.toFixed(2)})`);
  console.log(`Goal marked relative to robot at: (${goalX_robotFrame.toFixed(2)}, ${goalY_robotFrame.toFixed(2)})`);
};

const handleVelocity = (velocity: { Vx: number, Vy: number }) => {
  Vx.value = velocity.Vx;
  Vy.value = velocity.Vy;

  if (ws && isConnected.value) {
    const velocityCmd = {
      "action": "vel_cmd",
      "Vx": Vx.value,
      "Vy": Vy.value,
    };

    console.log(velocityCmd);
    ws.send(JSON.stringify(velocityCmd));
  }
};

const handleTouchStart = (event: TouchEvent) => {
  if (event.touches.length === 2) {
    const touch1 = event.touches[0];
    const touch2 = event.touches[1];

    touchStartDist = Math.hypot(
      touch1.clientX - touch2.clientX,
      touch1.clientY - touch2.clientY
    );
    touchStartZoom = zoomLevel.value;

    touchStart.value.x = touch1.clientX;
    touchStart.value.y = touch1.clientY;
  }
};

const handleTouchMove = (event: TouchEvent) => {
  if (event.touches.length === 2) {
    const touch1 = event.touches[0];
    const touch2 = event.touches[1];

    const touchDist = Math.hypot(
      touch1.clientX - touch2.clientX,
      touch1.clientY - touch2.clientY
    );

    const zoomFactor = touchDist / touchStartDist;
    zoomLevel.value = touchStartZoom * zoomFactor;
    zoomLevel.value = Math.max(0.1, Math.min(zoomLevel.value, 5.0));

    const xMovement = touch1.clientX - touchStart.value.x;
    const yMovement = touch1.clientY - touchStart.value.y;

    offsetX.value += xMovement * 1.50;
    offsetY.value += yMovement * 1.50;

    touchStart.value.x = touch1.clientX;
    touchStart.value.y = touch1.clientY;

    // adjustCanvasSize();
    // invalidateAllLayers();
    // drawCompositeMap(true);
  }
};

const handleTouchEnd = () => {
  touchStartDist = 0;
  touchStartZoom = 1.0;
  drawCompositeMap(true);
};

const handleMouseDown = (event: MouseEvent) => {
  isDragging.value = true;
  startDrag.value = { x: event.clientX, y: event.clientY };
};

const handleMouseMove = (event: MouseEvent) => {
  if (isDragging.value) {
    const dx = event.clientX - startDrag.value.x;
    const dy = event.clientY - startDrag.value.y;
    offsetX.value += dx;
    offsetY.value += dy;
    startDrag.value = { x: event.clientX, y: event.clientY };
    
    // Only mark robot and target layers as dirty (map doesn't need redraw)
    layerDirty.robot = true;
    layerDirty.target = true;
    drawCompositeMap();
  }
};

const handleMouseUp = () => {
  isDragging.value = false;
  drawCompositeMap(true);
};

// Optimized resize handling with debounce
const debouncedAdjustCanvasSize = () => {
  if (resizeTimeout) {
    clearTimeout(resizeTimeout);
  }

  resizeTimeout = setTimeout(() => {
    adjustCanvasSize();
    invalidateAllLayers();
    drawCompositeMap(true);
  }, 200);
};

// Memory management
const cleanupLayers = () => {
  Object.keys(layerCache).forEach(key => {
    if (layerCache[key as keyof typeof layerCache] && !layerVisibility.value[key as keyof typeof layerVisibility.value]) {
      layerCache[key as keyof typeof layerCache] = null;
    }
  });
};

const optimizeMemory = () => {
  cleanupLayers();
  // Force garbage collection hint (non-standard)
  const windowWithGC = window as WindowWithGC;
  if (windowWithGC.gc) {
    windowWithGC.gc();
  }
};

// Lifecycle hooks
onMounted(() => {
  connectWebSocket();
  window.addEventListener('resize', debouncedAdjustCanvasSize);
  
  // Performance monitoring
  const performanceMonitor = () => {
    updateFPS();
    requestAnimationFrame(performanceMonitor);
  };
  performanceMonitor();
  
  // Memory optimization every 30 seconds
  setInterval(optimizeMemory, 30000);
});

onBeforeUnmount(() => {
  if (ws) {
    ws.close();
  }
  if (reconnectTimeout) {
    clearTimeout(reconnectTimeout);
  }
  if (resizeTimeout) {
    clearTimeout(resizeTimeout);
  }
  window.removeEventListener('resize', debouncedAdjustCanvasSize);
});
</script>

